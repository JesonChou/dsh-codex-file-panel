{
  "name": "dsh-hello-plugin",
  "version": "0.1.0",
  "description": "Minimal dsh bundle template: a TypeScript plugin that logs on load and registers a dispose effect.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm run build",
    "test": "pnpm run build && node --test tests/hello.spec.js"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
