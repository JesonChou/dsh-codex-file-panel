{
  "name": "dsh-codex-files",
  "description": "DSH web plugin: Codex Desktop-style experience — global Codex dark theme, layout polish, and a right-side Files panel with session file list, preview, and edit/save.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "codex",
    "files",
    "editor"
  ],
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test && node scripts/verify-bundle.mjs",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-layout": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/schemastery": "*",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:./dsh-dev/ai/cordis",
    "@deepseek-ai/dsh-client-locale": "link:./dsh-dev/ai/dsh-client-locale",
    "@deepseek-ai/dsh-client-runtime": "link:./dsh-dev/ai/dsh-client-runtime",
    "@deepseek-ai/dsh-client-ui-conversation": "link:./dsh-dev/ai/dsh-client-ui-conversation",
    "@deepseek-ai/dsh-client-ui-layout": "link:./dsh-dev/ai/dsh-client-ui-layout",
    "@deepseek-ai/dsh-client-ui-primitives": "link:./dsh-dev/ai/dsh-client-ui-primitives",
    "@deepseek-ai/dsh-client-ui-slots": "link:./dsh-dev/ai/dsh-client-ui-slots",
    "@deepseek-ai/dsh-host-webserver": "link:./dsh-dev/ai/dsh-host-webserver",
    "@deepseek-ai/dsh-session": "link:./dsh-dev/ai/dsh-session",
    "@deepseek-ai/schemastery": "link:./dsh-dev/ai/schemastery",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "fflate": "^0.8.2",
    "jsdom": "^30.0.1",
    "pdfjs-dist": "^4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}